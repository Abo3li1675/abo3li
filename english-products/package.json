{
  "name": "english-products",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone interactive HTML products for teaching English to Arabic-speaking beginners",
  "type": "module",
  "scripts": {
    "build": "node build/build.js",
    "build:all": "node build/build.js --all",
    "build:vocabulary": "node build/build.js --product vocabulary",
    "build:grammar": "node build/build.js --product grammar",
    "build:conversations": "node build/build.js --product conversations",
    "build:sample": "node build/build.js --product vocabulary --lesson lesson-01-greetings",
    "package": "node build/package.js",
    "clean": "rm -rf dist audio-cache"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.36.0"
  },
  "engines": {
    "node": ">=18"
  }
}
