rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidImageSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    function isValidVideoSize() {
      return request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    // User profile photos
    match /users/{userId}/profile/{fileName} {
      allow read: if true; // Public read
      allow write: if isOwner(userId) &&
                     isValidImageType() &&
                     isValidImageSize();
      allow delete: if isOwner(userId);
    }

    // Progress photos (private)
    match /users/{userId}/progress/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) &&
                     isValidImageType() &&
                     isValidImageSize();
      allow delete: if isOwner(userId);
    }

    // Time-lapse photos (private)
    match /users/{userId}/timelapse/photos/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) &&
                     isValidImageType() &&
                     isValidImageSize();
      allow delete: if isOwner(userId);
    }

    // Time-lapse videos (can be public if shared)
    match /users/{userId}/timelapse/videos/{fileName} {
      allow read: if true; // Public read for shared videos
      allow write: if false; // Only cloud functions can write
      allow delete: if isOwner(userId);
    }

    // Community post media
    match /community/{userId}/posts/{fileName} {
      allow read: if true; // Public read
      allow write: if isOwner(userId) &&
                     (isValidImageType() || isValidVideoType()) &&
                     (isValidImageSize() || isValidVideoSize());
      allow delete: if isOwner(userId);
    }

    // Exercise videos and images (admin only)
    match /exercises/{exerciseId}/{fileName} {
      allow read: if true; // Public read
      allow write: if false; // Only admin through dashboard can write
    }

    // Recipe images (admin only)
    match /recipes/{recipeId}/{fileName} {
      allow read: if true; // Public read
      allow write: if false; // Only admin through dashboard can write
    }

    // Program images (admin only)
    match /programs/{programId}/{fileName} {
      allow read: if true; // Public read
      allow write: if false; // Only admin through dashboard can write
    }

    // Temporary uploads (24 hour expiry)
    match /temp/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) &&
                     isValidImageSize();
      allow delete: if isOwner(userId);
    }
  }
}
